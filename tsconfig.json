{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowJs": true,
        "strict": true,
        "types": ["vite/client", "node"],
        "paths": {
            "$lib": ["./web/src/lib"],
            "$lib/*": ["./web/src/lib/*"]
        }
    },
    "include": [
        "web/src/**/*",
        "vite.config.ts"
    ],
    "exclude": ["node_modules", "static", "dist"]
}
