{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "lib": ["DOM", "ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowJs": true,
        "strictNullChecks": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "assets/**/*",
        "vite.config.ts"
    ],
    "exclude": ["node_modules", "static", "dist"]
}
