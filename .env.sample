# Django
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_BASE_URL=https://blog.baseplate-admin.dev
DJANGO_ALLOWED_HOSTS=blog.baseplate-admin.dev,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://blog.baseplate-admin.dev,http://localhost:8000
DJANGO_LOG_LEVEL=INFO
WAGTAIL_SITE_NAME=The Tinkerer

# Database
POSTGRES_USER=postgres
# Required. Set this to a real password.
POSTGRES_PASSWORD=
POSTGRES_DB=blog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backblaze B2 media storage
# Required in production (django-storages).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://s3.backblazeb2.com
AWS_S3_REGION_NAME=us-east-005
AWS_S3_CUSTOM_DOMAIN=
AWS_LOCATION=media
